layoutSpacing: compact
render: auto
shapeSize: task (150, 52)
shapeSize: gateway (64, 64)
shapeSize: event (46, 46)
pool "Elena Torres — Personalized mRNA Neoantigen Therapy"
  lane "Clinic"
    event start none "Diagnosis & staging" as c1
    task "Consent for diagnostics + therapy" as c2
    c1 -> c2
    task "Order molecular profiling" as c3
    c2 -> c3

  lane "Specimen Intake"
    gateway parallel "Split specimen collection" as li0
    c3 -> li0
    task "Accession tumor specimen" as li1
    li0 -> li1
    task "Draw germline blood" as li2
    li0 -> li2

  lane "Histology + Sequencing"
    task "Confirm tumor content" as h1
    task "Merge assay inputs" as s0
    task "Sequence tumor WES/WGS" as s1
    task "Sequence germline + HLA" as s2
    gateway parallel "Merge sequencing outputs" as s3
    li1 -> h1: "Tumor specimen"
    li2 -> s0: "Germline sample"
    h1 -> s0: "Confirmed tumor"
    s0 -> s1
    s0 -> s2
    s1 -> s3
    s2 -> s3

  lane "Bioinformatics"
    task "Call somatic variants" as b1
    s3 -> b1: "Sequencing + HLA data"
    task "Predict + rank neoantigens" as b2
    b1 -> b2

  lane "Tumor Board"
    task "Multidisciplinary review" as tb1
    b2 -> tb1: "Ranked candidates"
    gateway exclusive "Vaccine candidate approved?" as tb2
    tb1 -> tb2
    task "Refer to alternate therapy" as tb3
    tb2 ->> tb3: "No"
    event end none "Alternate pathway" as tb4
    tb3 -> tb4

