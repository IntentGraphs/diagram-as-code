layoutSpacing: compact
render: auto
shapeSize: task (150, 52)
shapeSize: gateway (64, 64)
shapeSize: event (46, 46)
pool "Elena Torres — Personalized mRNA Neoantigen Therapy"
  lane "Clinic"
    event start none "Diagnosis & staging" as c1
    task "Consent for diagnostics + therapy" as c2
    c1 -> c2
    task "Order molecular profiling" as c3
    c2 -> c3

  lane "Specimen Intake"
    gateway parallel "Split specimen collection" as li0
    c3 -> li0
    task "Accession tumor specimen" as li1
    li0 -> li1
    task "Draw germline blood" as li2
    li0 -> li2

