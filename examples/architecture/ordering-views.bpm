diagram: architecture
workspace "Ordering Architecture" "C4 views for the ordering domain" {
model {
  customer = person "Customer" "Places orders" [tags: "actor,external", external: true]
  ordering = softwareSystem "Ordering System" "Processes orders" [tags: "core"]
  api = container ordering "Order API" "Accepts and validates orders" "Node.js/TypeScript" [tags: "api"]
  checkout = component api "Checkout" "Applies checkout rules" "TypeScript"
  orders = element "Orders Database" "Database"
  events = element "Order Events" "Queue"
  customer -> ordering "Places orders" "HTTPS/JSON" [tags: "synchronous"]
  api -> checkout "Validates order" "in-process" [tags: "synchronous"]
  checkout -> orders "Stores order" "PostgreSQL" [protocol: "SQL", tags: "data"]
  ordering -> events "Publishes order events" "Kafka" [tags: "asynchronous"]
}
views {
  view systemContext ordering as ordering-context "Ordering System Context"
  view container ordering as ordering-containers "Ordering Containers" [direction: down]
  view component api as api-components "Order API Components"
  view custom as data-and-events "Data Stores and Events" [direction: right]
}
