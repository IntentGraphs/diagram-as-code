render: manual

pool "Customer Portal"
  lane "Intake"
    event start none "Order received" as n1
    task "Customer Portal step n2" as n2
    task "Customer Portal step n3" as n3
    task "Customer Portal step n4" as n4
    task "Customer Portal step n5" as n5
    task "Customer Portal step n6" as n6
  lane "Order Desk"
    task "Customer Portal step n7" as n7
    task "Customer Portal step n8" as n8
    task "Customer Portal step n9" as n9
    task "Customer Portal step n10" as n10
    task "Customer Portal step n11" as n11
    gateway exclusive "Customer Portal check n12?" as n12
    task "Customer Portal step n13" as n13
    task "Customer Portal step n14" as n14
    task "Customer Portal step n15" as n15
    task "Customer Portal step n16" as n16
pool "Design Engineering"
  lane "Spec Review"
    task "Design Engineering step n17" as n17
    task "Design Engineering step n18" as n18
    task "Design Engineering step n19" as n19
    task "Design Engineering step n20" as n20
    task "Design Engineering step n21" as n21
    task "Design Engineering step n22" as n22
    task "Design Engineering step n23" as n23
    task "Design Engineering step n24" as n24
    task "Design Engineering step n25" as n25
    task "Design Engineering step n26" as n26
