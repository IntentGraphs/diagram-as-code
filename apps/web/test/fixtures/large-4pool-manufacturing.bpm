    task "Design Engineering step n33" as n33
    task "Design Engineering step n34" as n34
    task "Design Engineering step n35" as n35
    task "Design Engineering step n36" as n36
  lane "QA Sign-off"
    task "Design Engineering step n37" as n37
    task "Design Engineering step n38" as n38
    task "Design Engineering step n39" as n39
    task "Design Engineering step n40" as n40
    task "Design Engineering step n41" as n41
