    task "Logistics step n88" as n88
    task "Logistics step n89" as n89
    task "Logistics step n90" as n90
    task "Logistics step n91" as n91
    gateway exclusive "Logistics check n92?" as n92
    task "Logistics step n93" as n93
    task "Logistics step n94" as n94
    task "Logistics step n95" as n95
    task "Logistics step n96" as n96

