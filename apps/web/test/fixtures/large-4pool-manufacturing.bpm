    task "Design Engineering step n43" as n43
    task "Design Engineering step n44" as n44
    task "Design Engineering step n45" as n45
    task "Design Engineering step n46" as n46
pool "Shop Floor"
  lane "Fabrication"
    task "Shop Floor step n47" as n47
    task "Shop Floor step n48" as n48
    task "Shop Floor step n49" as n49
    task "Shop Floor step n50" as n50
    task "Shop Floor step n51" as n51
    task "Shop Floor step n52" as n52
    task "Shop Floor step n53" as n53
    task "Shop Floor step n54" as n54
    task "Shop Floor step n55" as n55
    task "Shop Floor step n56" as n56
  lane "Assembly"
    task "Shop Floor step n57" as n57
    task "Shop Floor step n58" as n58
    task "Shop Floor step n59" as n59
    task "Shop Floor step n60" as n60
    task "Shop Floor step n61" as n61
    gateway exclusive "Shop Floor check n62?" as n62
    task "Shop Floor step n63" as n63
    task "Shop Floor step n64" as n64
    task "Shop Floor step n65" as n65
    task "Shop Floor step n66" as n66
  lane "Inspection"
    task "Shop Floor step n67" as n67
    task "Shop Floor step n68" as n68
    task "Shop Floor step n69" as n69
    task "Shop Floor step n70" as n70
    task "Shop Floor step n71" as n71
    gateway exclusive "Shop Floor check n72?" as n72
    task "Shop Floor step n73" as n73
    task "Shop Floor step n74" as n74
    task "Shop Floor step n75" as n75
    task "Shop Floor step n76" as n76
pool "Logistics"
  lane "Packaging"
    task "Logistics step n77" as n77
    task "Logistics step n78" as n78
    task "Logistics step n79" as n79
    task "Logistics step n80" as n80
    task "Logistics step n81" as n81
    task "Logistics step n82" as n82
    task "Logistics step n83" as n83
    task "Logistics step n84" as n84
    task "Logistics step n85" as n85
    task "Logistics step n86" as n86
  lane "Shipping"
